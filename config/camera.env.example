# Copy to camera.env (gitignored) and pick ONE backend.

# --- Mac local OpenCV (D405 RGB via AVFoundation; no metric depth) ---
# CAMERA_BACKEND=opencv
# CAMERA_INDEX=0
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
# CAMERA_FPS=15

# --- HP Omen publishes cameras over LAN (Wi-Fi or direct Ethernet) ---
# On the Omen: omen\run_publish.bat
# Dual D405 + overhead:
#   python omen\publish_d405.py --list-realsense
#   python omen\publish_d405.py --wrist-serial <S1> --base-serial <S2> --webcam-index 2
#
# Wi-Fi: ZMQ_HOST = Omen LAN IPv4 from `ipconfig` (same SSID as the Mac).
# Direct USB-Ethernet (preferred for teleop/record bandwidth):
#   Omen (Admin): omen\setup_ethernet_link.bat   → 192.168.2.2
#   Mac:          bash scripts/21_use_ethernet_link.sh  → 192.168.2.1, sets ZMQ_HOST below
#   Then ZMQ_HOST=192.168.2.2
CAMERA_BACKEND=zmq
ZMQ_HOST=CHANGE_ME_OMEN_LAN_IP
ZMQ_PORT=5555
# 3 RGB views: wrist D405, USB overhead, base D405
CAMERA_NAMES=wrist,overhead,base
CAMERA_NAME=wrist
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
CAMERA_USE_DEPTH=true

# --- Direct Librealsense (usually fails on macOS; works on Windows/Linux) ---
# CAMERA_BACKEND=intelrealsense
# CAMERA_SERIAL=0123456789
# CAMERA_USE_DEPTH=true
