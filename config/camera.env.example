# Copy to camera.env (gitignored) and pick ONE backend.

# --- Mac local OpenCV (D405 RGB via AVFoundation; no metric depth) ---
# CAMERA_BACKEND=opencv
# CAMERA_INDEX=0
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
# CAMERA_FPS=15

# --- HP Omen publishes D405 over LAN (recommended for RealSense) ---
# On the Omen: python omen/publish_d405.py
# ZMQ_HOST = that PC's IPv4 (ipconfig). Same Wi-Fi as the Mac.
CAMERA_BACKEND=zmq
ZMQ_HOST=CHANGE_ME_OMEN_LAN_IP
ZMQ_PORT=5555
CAMERA_NAME=front
BIRDSEYE_NAME=birdseye
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
CAMERA_USE_DEPTH=false

# --- Direct Librealsense (usually fails on macOS; works on Windows/Linux) ---
# CAMERA_BACKEND=intelrealsense
# CAMERA_SERIAL=0123456789
# CAMERA_USE_DEPTH=true
