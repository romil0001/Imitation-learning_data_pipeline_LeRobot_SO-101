# Copy to ports.env and fill after running scripts/01_find_port.sh
# Example Mac paths: /dev/tty.usbmodem575E0032081

# local = follower USB on Mac (default)
# remote = follower USB on Omen; Mac talks over ZMQ (omen/robot_bridge.py)
FOLLOWER_BACKEND=local

FOLLOWER_PORT=CHANGE_ME_FOLLOWER
LEADER_PORT=CHANGE_ME_LEADER

# When FOLLOWER_BACKEND=remote, set ROBOT_HOST to the Omen LAN IP
# (defaults to ZMQ_HOST from camera.env if omitted). FOLLOWER_PORT can be "remote".
# ROBOT_HOST=192.168.0.59
# ROBOT_STATE_PORT=5556
# ROBOT_CMD_PORT=5557
# FOLLOWER_PORT=remote

# Stable calibration ids (do not change after first calibrate unless intentional)
FOLLOWER_ID=my_follower_arm
LEADER_ID=my_leader_arm

# Follower Feetech position PID (applied at connect). Lower P / higher D if the arm jitters.
FOLLOWER_P=10
FOLLOWER_I=0
FOLLOWER_D=48
FOLLOWER_BUS_RETRIES=8
